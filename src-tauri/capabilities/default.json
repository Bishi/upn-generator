{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "**/*.[pP][dD][fF]" },
        { "path": "**/*.[jJ][pP][gG]" },
        { "path": "**/*.[jJ][pP][eE][gG]" },
        { "path": "**/*.[pP][nN][gG]" },
        { "path": "**/*.[bB][mM][pP]" },
        { "path": "**/*.[tT][iI][fF]" },
        { "path": "**/*.[tT][iI][fF][fF]" }
      ]
    },
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
